{
  "name": "university",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:migrate": "turbo run db:migrate --filter=api",
    "db:migrate:step": "turbo run db:migrate:step --filter=api",
    "db:rollback": "turbo run db:rollback --filter=api",
    "db:rollback:base": "turbo run db:rollback:base --filter=api",
    "db:generate": "turbo run db:generate --filter=api --",
    "db:generate:blank": "turbo run db:generate:blank --filter=api --",
    "db:check": "turbo run db:check --filter=api",
    "db:current": "turbo run db:current --filter=api",
    "db:history": "turbo run db:history --filter=api",
    "db:merge": "turbo run db:merge --filter=api --",
    "db:stamp": "turbo run db:stamp --filter=api --"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
